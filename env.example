# ===== cope settings =====
# Copy this file, rename the copy to .env, then fill it in.

# Port the website runs on (open http://localhost:3000)
PORT=3000

# Your API-Football key from https://dashboard.api-football.com
# Leave it empty and start with "npm run test-mode" to use the built-in practice matches.
API_FOOTBALL_KEY=

# League ids on API-Football: 39 Premier League, 140 La Liga, 135 Serie A,
# 78 Bundesliga, 61 Ligue 1, 88 Eredivisie
LEAGUES=39,140,135,78,61,88

# Season = the year the season started (2026 for the 2026/27 season)
SEASON=2026

# How often to pull live stats while matches are on, in seconds
LIVE_POLL_SECONDS=60

# Minutes to wait after full time before bets settle (real books use 30)
SETTLE_DELAY_MINUTES=30

# Points every new player starts with
START_POINTS=10000
